<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Crypto protection</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  </head>

  <body>
    <form method="post" target="_self" action="/">
      <h1>Encrypted database!</h1>
      <p><input size="40" type="password" value="" placeholder="Password" name="initpass" maxlength="1024" autocomplete="off" autofocus>
      <p><input size="40" type="text" value="" placeholder="Page size (default is 4096 bytes)" name="pagesize" maxlength="1024" autocomplete="off">
      <p><input type="image" src="[special:skin]/_images/decrypt.png" name="submit" value="Decrypt">
    </form>
  </body>
</html>
