<form method="post" action="/!settings">
  <h2>[const:ttlSettings]</h2>

  [case:[message]||<p>[case:[error]||<mark>][message][case:[error]||</mark>]]

  <center><input type="submit" name="save" value="[const:btnSave]">&nbsp;<input type="reset" name="save" value="Reset"></center>

  <fieldset><legend>[const:tabHTML]</legend>
    <p><label>[const:ttlTitle]:<br><input type="text" value="[forum_title]" name="forum_title" maxlength="512"></label>
    <p><label>[const:ttlHeader]:<br><textarea rows=8 cols=20 name="forum_header">[forum_header]</textarea></label>
    <p><label>[const:ttlDesc]:<br><input type="text" value="[description]" name="description" maxlength="256"></label>
    <p><label>[const:ttlKeywords]:<br><input type="text" value="[keywords]" name="keywords" maxlength="256"></label>
    <p><label>[const:ttlIgnoreCSS]:<br><input type="text" value="[ignore_style]" name="ignore_style" maxlength="512"></label>
    <p><label><input type="checkbox" [embeded_css] name="embeded_css">[const:ttlEmbeded]</label>
  </fieldset>
  <p>
  <fieldset><legend>[const:tabServer]</legend>
    <p><label>[const:ttlHost]:<br><input type="text" value="[host]" name="host" maxlength="320"></label>
    <p><label>[const:ttlSMTP]:<br><input type="text" value="[smtp_addr]" name="smtp_addr" maxlength="256"></label>
       <input type="text" value="[smtp_port]" name="smtp_port" maxlength="5">
    <p><label>[const:ttlPipe]:<br><input type="text" value="[smtp_exec]" name="smtp_exec" maxlength="256"></label>
    <p><label>[const:ttlAccount]:<br><input type="text" value="[smtp_user]" name="smtp_user" maxlength="256"></label>
    <p><label><input type="checkbox" [email_confirm] name="email_confirm">[const:ttlConfirm]</label>
  </fieldset>
  <p>
  <fieldset><legend>[const:tabPermissions]</legend>
    <fieldset><legend>[const:ttlPermNew]:</legend>
      <label><input type="checkbox" [user_perm0]  name="user_perm" value="1">[const:pLogin]</label><br>
      <label><input type="checkbox" [user_perm1]  name="user_perm" value="2">[const:pRead]</label><br>
      <label><input type="checkbox" [user_perm2]  name="user_perm" value="4">[const:pPost]</label><br>
      <label><input type="checkbox" [user_perm3]  name="user_perm" value="8">[const:pStart]</label><br>
      <label><input type="checkbox" [user_perm4]  name="user_perm" value="16">[const:pEditOwn]</label><br>
      <label><input type="checkbox" [user_perm5]  name="user_perm" value="32">[const:pEditAll]</label><br>
      <label><input type="checkbox" [user_perm6]  name="user_perm" value="64">[const:pDelOwn]</label><br>
      <label><input type="checkbox" [user_perm7]  name="user_perm" value="128">[const:pDelAll]</label><br>
      <label><input type="checkbox" [user_perm8]  name="user_perm" value="256">[const:pChat]</label><br>
      <label><input type="checkbox" [user_perm9]  name="user_perm" value="512">[const:pDownload]</label><br>
      <label><input type="checkbox" [user_perm10] name="user_perm" value="1024">[const:pAttach]</label><br>
      <label><input type="checkbox" [user_perm11] name="user_perm" value="2048">[const:pVote]</label><br>
      <label><input type="checkbox" [user_perm12] name="user_perm" value="4096">[const:pMultiquote]</label><br>
      <label><input type="checkbox" [user_perm31] name="user_perm" value="$80000000">[const:pAdmin]</label><br>
      <p><label>[const:ttlInterval]:<br><input type="text" value="[post_interval]" name="post_interval" maxlength="256"></label>
      <p><label>[const:ttlIntervalInc]:<br><input type="text" value="[post_interval_inc]" name="post_interval_inc" maxlength="256"></label>
      <p><label>[const:ttlMaxPostLength]:<br><input type="text" value="[max_post_length]" name="max_post_length" maxlength="256"></label>
    </fieldset>
    <p>
    <fieldset><legend>[const:ttlPermGuests]:</legend>
      <label><input type="checkbox" [anon_perm0]  name="anon_perm" value="1">[const:pRegister]</label><br>
      <label><input type="checkbox" [anon_perm1]  name="anon_perm" value="2">[const:pRead]</label><br>
      <label><input type="checkbox" [anon_perm8]  name="anon_perm" value="256">[const:pChat]</label><br>
      <label><input type="checkbox" [anon_perm9]  name="anon_perm" value="512">[const:pDownload]</label><br>

      <p><label>[const:ttlActivationTime]:<br><input type="text" value="[activate_min_interval]" name="activate_min_interval" maxlength="256"></label>
    </fieldset>
  </fieldset>
    <p>
  <fieldset><legend>[const:tabFeatures]</legend>
    <p><label>[const:ttlLang]:
    <select name="default_lang">
      <option value="0" [case:[default_lang]|selected="selected"|]>English</option>
      <option value="1" [case:[default_lang]||selected="selected"|]>Български</option>
      <option value="2" [case:[default_lang]|||selected="selected"|]>Русский</option>
      <option value="3" [case:[default_lang]||||selected="selected"|]>Français</option>
      <option value="4" [case:[default_lang]|||||selected="selected"|]>Deutsch</option>
    </select>

    <p><label>[const:ttlPgLen]:<br><input type="text" value="[page_length]" name="page_length" maxlength="256"></label>
    <p><label>[const:ttlSkin]: <select name="default_skin" >[special:skins=[default_skin]]</select></label>
    <p><label>[const:ttlMobile]: <select name="default_mobile_skin">[special:skins=[default_mobile_skin]]</select></label>
    <p><label><input type="checkbox" [chat_enabled] name="chat_enabled">[const:ttlChat]</label>
    <fieldset><legend>[const:ttlMarkup]</legend>
      <label><input type="checkbox" [markup0] name="markups" value="1"> MiniMag (like markdown)</label><br>
      <label><input type="checkbox" [markup1]  name="markups" id="mu1"  value="2"> BBCode</label>
    </fieldset>
  </fieldset>

  <fieldset><legend>[const:tabEncryption]</legend>
    <p><label>[const:ttlNewPassword]:<br><input type="text" value="" placeholder="Encryption password" name="password" maxlength="1024">
    <p><label><input type="checkbox" name="decrypt" value="1"> Remove the encryption</label>
    <article>
      [const:helpEncryption]
    </article>
  </fieldset>

  <input type="hidden" name="ticket" value="[Ticket]" >

  <p>
  <center><input type="submit" name="save" value="[const:btnSave]">&nbsp;<input type="reset" name="save" value="Reset"></center>
</form>

