<form method="post" action="/!userinfo/[url:[html:[UserName]]]">

  <fieldset>
    <legend>[const:hdrDesc]</legend>
    <textarea rows=15 cols=20 name="user_desc">[user_desc]</textarea>
  </fieldset>
  <br>

  [case:[special:isadmin]||
  <fieldset>
    <legend>[const:hdrPermissions]</legend>
    <table cellpadding=4 width=100%><tr>
      <td valign=top>
        <label><input type="checkbox" [user_perm0]  name="user_perm" value="1">[const:pLogin]</label><br>
        <label><input type="checkbox" [user_perm1]  name="user_perm" value="2">[const:pRead]</label><br>
        <label><input type="checkbox" [user_perm2]  name="user_perm" value="4">[const:pPost]</label><br>
        <label><input type="checkbox" [user_perm3]  name="user_perm" value="8">[const:pStart]</label><br>
        <label><input type="checkbox" [user_perm4]  name="user_perm" value="16">[const:pEditOwn]</label><br>
        <label><input type="checkbox" [user_perm5]  name="user_perm" value="32">[const:pEditAll]</label><br>
        <label><input type="checkbox" [user_perm6]  name="user_perm" value="64">[const:pDelOwn]</label><br>
      <td valign=top>
        <label><input type="checkbox" [user_perm7]  name="user_perm" value="128">[const:pDelAll]</label><br>
        <label><input type="checkbox" [user_perm8]  name="user_perm" value="256">[const:pChat]</label><br>
        <label><input type="checkbox" [user_perm9]  name="user_perm" value="512">[const:pDownload]</label><br>
        <label><input type="checkbox" [user_perm10] name="user_perm" value="1024">[const:pAttach]</label><br>
        <label><input type="checkbox" [user_perm11] name="user_perm" value="2048">[const:pVote]</label><br>
        <label><input type="checkbox" [user_perm12] name="user_perm" value="4096">[const:pMultiquote]</label><br>
        <label><input type="checkbox" [user_perm31] name="user_perm" value="$80000000">[const:pAdmin]</label><br>
    </table>
  
    <p><label>[const:hdrInterval]<br><input type="text" value="[PostInterval]" name="PostInterval" autocomplete="off"></label>
    <p><label>[const:hdrIncrement]<br><input type="text" value="[PostIntervalInc]" name="PostIntervalInc" autocomplete="off"></label>
    <p><label>[const:hdrMaxLen]<br><input type="text" value="[MaxPostLen]" name="MaxPostLen" autocomplete="off"></label>
  </fieldset>
  ]
  
  <input type="hidden" name="ticket" value="[Ticket]">
  <p><input type="submit" name="save" value="[const:btnSave]">
</form>


<form method="post" enctype="multipart/form-data" action="/!avatar_upload/[url:[html:[UserName]]]">
  <fieldset><legend>[const:hdrAvatar]</legend>
    <p><input type="file" id="input-file-browse" name="avatar"></label>

    <input type="hidden" name="ticket" value="[Ticket]">
    <p><input type="submit" name="submit" value="[const:btnUpload]">
  </fieldset>
</form>

<br>

<form method="post" action="/!setskin/[url:[html:[UserName]]]">
  <fieldset><legend>User interface</legend>
  <p><label>[const:hdrLang]&nbsp;<select name="user_lang">
    <option value="0" [case:[Lang]|selected="selected"|]>[const:sDefault]</option>
    <option value="1" [case:[Lang]||selected="selected"|]>English</option>
    <option value="2" [case:[Lang]|||selected="selected"|]>Български</option>
    <option value="3" [case:[Lang]||||selected="selected"|]>Русский</option>
    <option value="4" [case:[Lang]|||||selected="selected"|]>Français</option>
    <option value="5" [case:[Lang]||||||selected="selected"|]>Deutsch</option>
  </select></label>
  
  <p><label>[const:hdrSkin]&nbsp;<select name="skin">
    <option value="0">[const:sDefault]</option>
    [special:skins=[skin]]
  </select></legend>
  
  <input type="hidden" name="ticket" value="[Ticket]">
  <p><input type="submit" name="save" value="[const:btnSave]"></div>
</form>


[case:[ItIsMe]| |
<br>
<form method="post" action="/!changepassword">
  <fieldset>
    <legend>[const:hdrChangePass]</legend>
  
    <p><input type="password" value="" placeholder="[const:passNow]" name="oldpass" maxlength="1024" autocomplete="off">
    <p><input type="password" value="" placeholder="[const:passNew]" name="newpass" maxlength="1024" autocomplete="off">
    <p><input type="password" value="" placeholder="[const:passNew2]" name="newpass2" maxlength="1024" autocomplete="off"><br>

    <input type="hidden" name="ticket" value="[Ticket]">
    <p><input type="submit" name="changepass" value="[const:btnChangePass]">
  </fieldset>
</form>

<form cmethod="post" action="/!changemail">
  <fieldset>
    <legend>[const:hdrChangeEmail]</legend>

    <p><input type="password" value="" placeholder="[const:passPass]" name="password" maxlength="1024" autocomplete="off">
    <p><input type="text" value="[email]" placeholder="[const:emailNew]" name="email" maxlength="320">
    <p><input type="hidden" name="ticket" value="[Ticket]">
    <p><input type="submit" name="changeemail" value="[const:btnChangeEmail]">
  </fieldset>
</form>
]


